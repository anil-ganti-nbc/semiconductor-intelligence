#!/usr/bin/env bash
# Launch the Semi Intel dashboard locally, bound to localhost only, against
# the isolated local staging database.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [ ! -x ".venv/bin/semintel" ]; then
    echo "error: no .venv found. Run mac/bootstrap first." >&2
    exit 1
fi

PORT="${SEMINTEL_MAC_PORT:-8000}"
mkdir -p "${REPO_ROOT}/.mac-dev"
export SEMI_INTEL_DB_URL="sqlite:///${REPO_ROOT}/.mac-dev/semi_intel.db"

echo "==> Dashboard: http://127.0.0.1:${PORT}/"
echo "    (Ctrl+C to stop)"
echo ""

exec .venv/bin/semintel gui --host 127.0.0.1 --port "$PORT" --no-browser
