#!/usr/bin/env bash
# Set up (or reuse) a local macOS dev environment for Semiconductor
# Intelligence. Safe to re-run: never destroys an existing .venv, only
# installs/updates deps and applies migrations.
#
# Python 3.13 to match the project's own documented Windows baseline and
# its Docker image (python:3.13-slim-bookworm) -- pyproject.toml's floor
# is 3.10, but 3.13 is what this repo is actually verified against.
#
# This is Tier B staging/soak, not production -- these scripts don't
# change that. The optional Playwright/X collector extra is never
# installed here; see mac/README-x-extra if you need it.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

PYTHON_VERSION="3.13"

if ! command -v uv >/dev/null 2>&1; then
    echo "error: 'uv' is not installed or not on PATH." >&2
    echo "  Install it from https://docs.astral.sh/uv/ and re-run this script." >&2
    exit 1
fi

if [ -d ".venv" ]; then
    echo "==> Reusing existing .venv"
else
    echo "==> Creating .venv (Python $PYTHON_VERSION)"
    uv venv --python "$PYTHON_VERSION" .venv
fi

echo "==> Installing/updating dependencies (dev + web extras; Playwright/X excluded)"
uv pip install --python .venv/bin/python -e ".[dev,web]"

mkdir -p .mac-dev
echo "==> Setting up isolated local staging database"
# Deliberately NOT using `semintel install --data-dir` here: it rewrites the
# tracked, portable-by-design semintel.config.json in place (data_dir "."),
# which would leave this machine's absolute path committed. SEMI_INTEL_DB_URL
# overrides cleanly without touching any tracked file.
SEMI_INTEL_DB_URL="sqlite:///${REPO_ROOT}/.mac-dev/semi_intel.db" \
    .venv/bin/semi-intel db upgrade

echo ""
echo "Bootstrap complete."
echo "  Local staging state lives in: $REPO_ROOT/.mac-dev/ (gitignored, isolated"
echo "  from the real macOS default location ~/Library/Application Support/SemiIntel)."
echo "  Next: mac/test, mac/health, mac/dashboard, or mac/backup-restore-smoke"
